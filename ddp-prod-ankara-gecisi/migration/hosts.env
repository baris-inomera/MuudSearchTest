# ---------------------------------------------------------------------------
# ddp-prod-cluster — topoloji tanımı (TEK DOĞRU KAYNAK)
# Tüm migration script'leri bu dosyayı source eder.
# ---------------------------------------------------------------------------

CLUSTER_NAME="ddp-prod-cluster"

# --- Kimlik bilgileri ------------------------------------------------------
ES_USER="${ES_USER:-ddpprod}"
ES_PASSWORD="${ES_PASSWORD:-Ddp123Prod_456Elastic}"

# --- Awareness (zone) attribute -------------------------------------------
# Mevcut node'larda zaten node.attr.rack var; lokasyon ayrımı için yeni bir
# attribute uydurmuyoruz, aynısını kullanıyoruz.
AWARENESS_ATTR="rack"
ZONE_IST="ddp-istanbul"
ZONE_ANK="ddp-ankara"

# --- İstanbul (mevcut, çalışıyor) -----------------------------------------
IST_MASTER_1_IP="10.95.27.26"   ; IST_MASTER_1_NAME="ddp-prod-ist-master-1"
IST_MASTER_2_IP="10.95.27.27"   ; IST_MASTER_2_NAME="ddp-prod-ist-master-2"
IST_MASTER_3_IP="10.95.27.28"   ; IST_MASTER_3_NAME="ddp-prod-ist-master-3"  # <-- DECOMMISSION
IST_DATA_4_IP="10.95.27.29"     ; IST_DATA_4_NAME="ddp-prod-ist-data-4"
IST_DATA_5_IP="10.95.27.30"     ; IST_DATA_5_NAME="ddp-prod-ist-data-5"

# --- Ankara (yeni, boş) ----------------------------------------------------
# Ankara'da 5 makine hazır: .96 .97 .98 (master adayı) / .99 .100 (data).
# Hedef topoloji 1 ANK master istiyor -> .97 seçildi.
# .96 KULLANILMADI: ist-master-1'in reindex.remote.whitelist ayarında geçiyor,
# orada çalışan bir ES olabilir. .98 yedekte duruyor.
ANK_MASTER_1_IP="10.6.245.97"   ; ANK_MASTER_1_NAME="ddp-prod-ank-master-1"
ANK_DATA_1_IP="10.6.245.99"     ; ANK_DATA_1_NAME="ddp-prod-ank-data-1"
ANK_DATA_2_IP="10.6.245.100"    ; ANK_DATA_2_NAME="ddp-prod-ank-data-2"

# --- Hedef topoloji --------------------------------------------------------
# 2 IST + 1 ANK master (quorum 2) · 2 IST + 2 ANK data · toplam 7 node.
TARGET_NODE_COUNT=7
TARGET_MASTER_COUNT=3

SEED_HOSTS=("${IST_MASTER_1_IP}" "${IST_MASTER_2_IP}" "${ANK_MASTER_1_IP}")

NODES_PHASE0=("${IST_MASTER_1_NAME}" "${IST_MASTER_2_NAME}" "${IST_MASTER_3_NAME}" \
              "${IST_DATA_4_NAME}" "${IST_DATA_5_NAME}")
NODES_ANK=("${ANK_MASTER_1_NAME}" "${ANK_DATA_1_NAME}" "${ANK_DATA_2_NAME}")

# --- Yedekleme: SOĞUK KOPYA ------------------------------------------------
# Ortamda paylaşımlı disk (NFS) kurulamadığı için ES snapshot'ı yerine soğuk
# kopya alıyoruz.
#
# Neden çalışıyor: 5 index x 1 shard x rep=1 = 10 shard kopyası, 2 data node.
# ES bir shard'ın primary'si ile replica'sını asla aynı node'a koymaz; dolayısıyla
# .29 ve .30'un HER BİRİ 5 index'in de birer kopyasını tutar. Yani tek bir data
# node'un veri klasörü = tüm verinin tam kopyası.
#
# UYARI: Bu varsayım index/shard sayısı değişirse BOZULUR. 02-backup.sh her
# çalıştığında bunu yeniden doğrular, varsayıma güvenmez.
BACKUP_NODE_NAME="${IST_DATA_5_NAME}"      # kopyası alınacak data node (.30)
BACKUP_NODE_IP="${IST_DATA_5_IP}"
BACKUP_DATA_PATH="/data/elasticsearch-data"   # o node'daki path.data
BACKUP_DEST_DIR="/yedek"                      # tar dosyasının yazılacağı yer

# Script çıktıları (ayar dump'ları, raporlar). Rollback bunları kullanır, silmeyin.
ARTIFACT_DIR="${ARTIFACT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/artifacts}"

# --- Script'lerin konuşacağı ES endpoint'i --------------------------------
# xpack.security.http.ssl kapalı olduğu için http. Açılırsa https yapın.
ES_URL="${ES_URL:-http://${IST_MASTER_1_IP}:9200}"

# --- WAN recovery throttle -------------------------------------------------
# IST<->ANK shard kopyalaması bu hızla sınırlanır. Hattı doldurup uygulama
# trafiğini aç bırakmamak için düşük başlayın, izleyip yükseltin. ES default 40mb.
RECOVERY_MAX_BYTES_PER_SEC="40mb"
NODE_CONCURRENT_RECOVERIES="2"
